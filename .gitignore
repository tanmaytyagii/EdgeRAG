# The SPA is compiled into backend/static by `npm run build`. It is a build
# artifact and is rebuilt on install, so it is not committed.
backend/static/

# ------------------------------------------------------- EdgeRAG local data ---
# Everything EdgeRAG writes at runtime lives under EDGERAG_DATA_DIR
# (~/.edgerag by default). These entries cover the case where a contributor
# points it at the repository.
#
# Anchored with a leading slash on purpose: an unanchored `documents/` would
# also swallow frontend/src/components/documents/, which is source code.
/.edgerag/
/data/
/uploads/
/documents/
/index/
/indexes/

# SQLite
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Vector stores and keyword indexes
*.npy
*.faiss
chroma/
chroma_db/
.chroma/
*.bm25.jsonl

# Model weights and caches. These are downloaded on first use, never committed.
/models/
*.gguf
*.safetensors
*.onnx
*.bin
*.pt
*.pth
.cache/
.huggingface/
.ollama/

# ------------------------------------------------------------- Secrets/env ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

