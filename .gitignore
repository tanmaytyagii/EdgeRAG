*.swp
*.swo
*~
.\#*
\#*\#

# --------------------------------------------------------------------- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------- Archives ---
*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z

# ------------------------------------------------------------- Documents ---
# EdgeRAG indexes your documents; it does not carry them. PDFs are ignored by
# default so a local corpus is never committed by accident. The exception is
# samples/, which holds only original CC0 material written for this repository.
*.pdf
!samples/**/*.pdf

# Notebook outputs are stripped before committing; the research notebook is
# kept for provenance, not for its recorded results.
.ipynb_checkpoints/

# --------------------------------------------------------------- Temporary ---
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
