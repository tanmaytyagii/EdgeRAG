# ===========================================================================
#  EdgeRAG configuration
#
#  Copy this file to `.env` and edit. Nothing here is required — every value
#  shown is the built-in default, so EdgeRAG runs with no .env at all.
#
#  Precedence: defaults < .env < environment variables < Settings page.
#  Nested settings use a DOUBLE underscore: EDGERAG_LLM__MODEL.
#
#  This file contains no credentials, and EdgeRAG needs none: there are no
#  API keys, tokens or accounts anywhere in the local workflow.
# ===========================================================================

# --------------------------------------------------------------- Application
EDGERAG_APP_NAME=EdgeRAG

# Where documents, indexes and the SQLite database are written.
# Contains: edgerag.db, documents/, index/, cache/
EDGERAG_DATA_DIR=~/.edgerag

# Bound to localhost by default, deliberately: EdgeRAG has no authentication.
# Exposing it on 0.0.0.0 exposes every indexed document to your network.
EDGERAG_HOST=127.0.0.1
EDGERAG_PORT=8000

# Comma-separated. Only needed for the Vite dev server on a non-default port,
# or when the frontend is deployed on a different origin from the API (see the
# hosted-deployment block at the end of this file).
EDGERAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EDGERAG_LOG_LEVEL=INFO

# Adds internal detail and stack traces to API error responses. Off in normal use.
EDGERAG_DEVELOPER_MODE=false

# EdgeRAG ships no remote telemetry. This flag is reserved and currently unused;
# there is no code path that sends anything anywhere.
EDGERAG_TELEMETRY_ENABLED=false

# ----------------------------------------------------------------- Chunking
# Applies to newly indexed documents only. Re-index existing documents from the
# Documents page (or `edgerag ingest`) to adopt changed values.
EDGERAG_CHUNKING__CHUNK_SIZE=800
EDGERAG_CHUNKING__CHUNK_OVERLAP=100
EDGERAG_CHUNKING__SPLITTER=recursive
# Fragments shorter than this are dropped as noise.
EDGERAG_CHUNKING__MIN_CHUNK_CHARS=48

# --------------------------------------------------------------- Embeddings
# `sentence-transformers` requires the [local] extra (pulls torch).
# `hash-dev` is a deterministic hashing embedder for CI and smoke tests. It has
# NO semantic meaning — never use it to judge retrieval quality.
EDGERAG_EMBEDDING__PROVIDER=sentence-transformers
EDGERAG_EMBEDDING__MODEL=sentence-transformers/all-MiniLM-L6-v2
# Must match the model. Changing either invalidates existing indexes.
EDGERAG_EMBEDDING__DIMENSIONS=384
EDGERAG_EMBEDDING__BATCH_SIZE=64
EDGERAG_EMBEDDING__NORMALIZE=true

# ------------------------------------------------------------- Vector store
# `numpy`  — persisted .npy + .jsonl, exact brute-force cosine search (default)
# `chroma` — requires the [chroma] extra; uses a PersistentClient
EDGERAG_VECTOR_STORE__PROVIDER=numpy
EDGERAG_VECTOR_STORE__COLLECTION_PREFIX=edgerag_kb_

# ---------------------------------------------------------------- Retrieval
# The funnel: dense + sparse -> fusion -> rerank -> context.
EDGERAG_RETRIEVAL__DENSE_TOP_K=40
# Keep comparable to dense, or the keyword arm contributes almost nothing.
EDGERAG_RETRIEVAL__SPARSE_TOP_K=40
EDGERAG_RETRIEVAL__FUSION_TOP_K=40
# The main latency knob: how many fused candidates the cross-encoder scores.
EDGERAG_RETRIEVAL__RERANK_TOP_K=40
# How many chunks actually reach the model.
EDGERAG_RETRIEVAL__CONTEXT_TOP_K=5
# RRF smoothing. Higher values flatten the influence of the very top ranks.
EDGERAG_RETRIEVAL__RRF_K=60
EDGERAG_RETRIEVAL__DENSE_WEIGHT=1.0
EDGERAG_RETRIEVAL__SPARSE_WEIGHT=1.0

# ----------------------------------------------------------------- Reranker
# Set PROVIDER=none to disable. EdgeRAG then orders by fusion score and reports
# the degradation in the UI, the API response and `edgerag doctor`.
EDGERAG_RERANKER__PROVIDER=cross-encoder
EDGERAG_RERANKER__MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EDGERAG_RERANKER__BATCH_SIZE=32

# ---------------------------------------------------------------- Generation
# Requires Ollama running locally: `ollama serve` and `ollama pull <model>`.
EDGERAG_LLM__PROVIDER=ollama
EDGERAG_LLM__MODEL=deepseek-r1:1.5b
EDGERAG_LLM__BASE_URL=http://localhost:11434
# Keep low. Grounded answers should not be creative.
EDGERAG_LLM__TEMPERATURE=0.1
EDGERAG_LLM__MAX_TOKENS=1024
# Raise for large models on CPU.
EDGERAG_LLM__TIMEOUT_SECONDS=180
# Reasoning models emit <think> blocks. Leave this on to keep them out of answers.
EDGERAG_LLM__STRIP_REASONING_TAGS=true

# ------------------------------------------------- Confidence and abstention
EDGERAG_CONFIDENCE__ENABLED=true
# Floor on the raw cross-encoder logit for the best chunk. Not a probability.
EDGERAG_CONFIDENCE__MIN_TOP_SCORE=0.0
EDGERAG_CONFIDENCE__MIN_SUPPORTING_CHUNKS=1
# Floor on the blended four-signal estimate (strength, margin, support, agreement).
EDGERAG_CONFIDENCE__MIN_CONFIDENCE=0.35
EDGERAG_CONFIDENCE__ABSTAIN_MESSAGE=The indexed sources do not provide enough information to answer this confidently.

# ------------------------------------------------------------------ Context
# Total characters assembled into the prompt, and the per-chunk cap.
EDGERAG_CONTEXT__MAX_CONTEXT_CHARS=6000
EDGERAG_CONTEXT__MAX_CHARS_PER_CHUNK=1600

# ------------------------------------------------------------------ Uploads
# 100 MB. Bodies stream to disk and abort past this without buffering.
EDGERAG_UPLOADS__MAX_FILE_BYTES=104857600
EDGERAG_UPLOADS__ALLOWED_EXTENSIONS=.pdf,.txt,.md,.markdown,.docx


# ===========================================================================
#  Hosted deployment (optional)
#
#  None of this is needed to run EdgeRAG locally, and none of it is on by
#  default. It exists so the project can also be published as a public demo:
#  a Vercel frontend talking to a Railway backend, answering from the bundled
#  sample documents through a hosted model.
#
#  The local, private, Ollama-backed mode is unchanged and remains the point of
#  the project. Set none of these and nothing below happens.
#
#  NEVER commit a filled-in copy of this block. Set these in the hosting
#  platform's own environment-variable UI.
# ===========================================================================

# Read-only public demo: ingestion, deletion and settings writes are refused.
# Leave false locally — indexing your own documents is the product.
# EDGERAG_DEMO_MODE=true

# Index the bundled CC0 samples at boot when the database is empty. Needed
# because hosted containers start with no disk.
# EDGERAG_DEMO_SEED_ON_STARTUP=true

# The browser origin of the deployed frontend. Required, or the browser blocks
# every API call. No trailing slash; comma-separate multiple origins.
# EDGERAG_CORS_ORIGINS=https://your-app.vercel.app

# --- Hosted model -----------------------------------------------------------
# `ollama` (default) keeps everything local. `openai-compatible` speaks the
# OpenAI chat-completions dialect and covers Groq, OpenAI, Together, OpenRouter
# and DeepSeek — pick whichever you have credit with.
# EDGERAG_LLM__PROVIDER=openai-compatible

# Groq's free tier is the cheapest practical option for a demo and is fast.
# EDGERAG_LLM__BASE_URL=https://api.groq.com/openai/v1
# EDGERAG_LLM__MODEL=llama-3.1-8b-instant

# The key. Server-side only: it is never returned by the API and never reaches
# the browser. Set it in the platform UI, not in a file.
# EDGERAG_LLM__API_KEY=

# Keep hosted answers short so a demo visitor cannot run up a bill.
# EDGERAG_LLM__MAX_TOKENS=512
