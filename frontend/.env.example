# Frontend build-time configuration. Copy to `frontend/.env` if you need it.
# These are compiled into the bundle by Vite, so put nothing secret here.

# Repository the landing page's "View on GitHub" links point at.
VITE_GITHUB_URL=https://github.com/tanmaytyagii/EdgeRAG

# Backend origin, for a split deployment where the frontend and the API are on
# different hosts (Vercel + Railway). Leave unset for local development and for
# the single-process Docker image, where the API is same-origin.
# No trailing slash.
# VITE_API_BASE_URL=https://your-backend.up.railway.app

# Cosmetic marker for the public build. The backend is what actually enforces
# read-only, via EDGERAG_DEMO_MODE.
# VITE_DEMO_MODE=true

# Everything prefixed VITE_ is compiled into the public bundle. Never put an API
# key here — the hosted model key belongs on the backend only.
